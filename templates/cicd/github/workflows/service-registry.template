name: Boiler CI
on:
  push:
    branches:
      - 'main'
    paths:
      - '**/proto_deps_config.yaml'

env:
  REPOSITORY_NAME: ${{ github.repository }}
  PROTO_DEPS_PATH: .config/proto_deps_config.yaml

jobs:
  service-registry:
    runs-on: self-hosted

    steps:
      - name: GitHub branch checkout
        uses: actions/checkout@v3

      - name: Build service dependencies graph
        run: |
          curl \
          --silent \
          --output /dev/null \
          --request POST \
          --header 'content-type: application/json' \
          --url http://localhost:8080/graph \
          --data '{
              "github_repo_name": "${{ env.REPOSITORY_NAME }}",
              "proto_deps_path": "${{ env.PROTO_DEPS_PATH }}"
          }'
          echo 'Builded service dependencies graph for $REPOSITORY_NAME: 
          http://localhost:8080/graph'
